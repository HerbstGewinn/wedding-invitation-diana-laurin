---
import type { Dict } from '../i18n/de';
interface Props { t: Dict }
const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const d = t.day;
const icons = ['key', 'ring', 'glasses', 'camera', 'plate', 'music', 'cake', 'fireworks', 'bed'];
const steps = [...d.items, { time: d.final.time, what: d.final.what, note: d.final.note }];
// her timeline: check-in on the right of the line, then alternating
const side = (i: number) => (i % 2 === 0 ? 'r' : 'l');
---

<section class="day" id="tag" aria-labelledby="day-h">
  <h2 class="script-h day__h" id="day-h" data-reveal>{d.heading}</h2>
  <p class="day__intro" data-reveal style="--d: 90ms">{d.intro}</p>

  <ol class="timeline">
    {steps.map((s, i) => (
      <li class={`tl tl--${side(i)}`} data-time={s.time} data-reveal style={`--d: ${(i % 3) * 70}ms`}>
        <p class="tl__note">{s.note}</p>
        <div class="tl__head">
          <img class="tl__icon" src={`${base}img/art/i-${icons[i]}.png`} alt="" loading="lazy" decoding="async" />
          <p class="tl__text"><time class="tl__time">{s.time}</time><span class="tl__what">{s.what}</span></p>
        </div>
      </li>
    ))}
  </ol>
</section>
