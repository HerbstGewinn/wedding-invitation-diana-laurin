---
import type { Dict } from '../i18n/de';
interface Props { t: Dict }
const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const p = t.pack;
// The ten dress-code colours from the invitation card.
const swatches = ['#edeae1', '#cdbca1', '#868d75', '#9eab96', '#3f5643', '#b3c4cf', '#9f6b4f', '#978978', '#47453f', '#5d432f'];
---

<section class="pack" id="einpacken" aria-labelledby="pack-h">
  <div class="pack__grid">
    <div class="pack__col" data-reveal>
      <h2 class="script-h pack__h" id="pack-h">{p.heading}</h2>
      <h3 class="pack__sub">{p.dressTitle}</h3>
      <ul class="swatches" aria-hidden="true">
        {swatches.map((c) => <li style={`background:${c}`}></li>)}
      </ul>
      <p>{p.dress}</p>
      <p>{p.shoes}</p>
    </div>
    <div class="pack__col pack__heart" data-reveal style="--d: 120ms">
      <h2 class="script-h pack__h">{p.heartTitle}</h2>
      {p.heart.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>
<figure class="band">
  <img src={`${base}img/us/bali-sunset.webp`} width="1800" height="2400" alt={p.photoAlt} loading="lazy" decoding="async" />
</figure>
