---
import type { Dict } from '../i18n/de';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="faq" id="faq" aria-labelledby="faq-h">
  <div class="faq__side">
    <h2 class="script-h faq__h" id="faq-h" data-reveal>{t.faq.heading}</h2>
  </div>
  <div class="faq__topics">
    {t.faq.topics.map((topic, i) => (
      <div class="faq__topic" data-reveal style={`--d: ${i * 80}ms`}>
        <h3 class="faq__topic-h">{topic.title}</h3>
        <div class="faq__topic-body">
          {topic.paras.map((para) => <p>{para}</p>)}
        </div>
      </div>
    ))}
  </div>
</section>
