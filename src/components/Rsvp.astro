---
import type { Dict } from '../i18n/de';
import { FORM_ACTION, FORM_VIEW, ENTRY, VALUE, STAY_REQUIRED_IN_FORM } from '../data/rsvp';

interface Props { t: Dict }
const { t } = Astro.props;
const r = t.rsvp;
const people = [
  { name: 'Laurin Herbst', tel: '+49 176 99252846', mail: 'herbst.laurin@gmail.com', mark: 'grapes' as const },
  { name: 'Diana Vinogradova', tel: '+372 555 17718', mail: 'diana.vinogradova11@gmail.com', mark: 'grapes' as const },
];
---

<section class="rsvp" id="antworten" aria-labelledby="rsvp-h">
  <div class="rsvp__side">
    <p class="script-h rsvp__line" data-reveal>{r.line}</p>
    <h3 class="rsvp__contact-h" data-reveal style="--d: 80ms">{r.contactHeading}</h3>
    <ul class="contacts">
      {people.map((p, i) => (
        <li class="contact" data-reveal style={`--d: ${140 + i * 80}ms`}>
          <img class="contact__mark" src={`${import.meta.env.BASE_URL}img/art/grapes.png`} width="63" height="49" alt="" loading="lazy" />
          <span class="contact__name">{p.name}</span>
          <a href={`tel:${p.tel.replace(/\s/g, '')}`}>{p.tel}</a>
          <a href={`mailto:${p.mail}`}>{p.mail}</a>
        </li>
      ))}
    </ul>
    <figure class="rsvp__kids shutter" data-reveal>
      <img src={`${import.meta.env.BASE_URL}img/us/curly-kids.webp`} width="1122" height="1402" alt={t.footer.kidsAlt} loading="lazy" decoding="async" />
    </figure>
  </div>

  <div class="reply" data-reveal style="--d: 120ms">
    <form
      class="reply__form"
      action={FORM_ACTION}
      method="POST"
      target="_blank"
      data-rsvp
      data-view={FORM_VIEW}
      data-stay-required={String(STAY_REQUIRED_IN_FORM)}
      data-sending={r.sending}
      data-submit={r.submit}
      data-names-yes={r.names.label}
      data-names-no={r.names.labelNo}
    >
      <h2 class="script-h reply__h" id="rsvp-h">{r.heading}</h2>

      <fieldset class="field">
        <legend>{r.attend.label}</legend>
        <div class="choices choices--big">
          <label class="choice"><input type="radio" name={ENTRY.attend} value={VALUE.attend.yes} required data-attend="yes" /><span>{r.attend.yes}</span></label>
          <label class="choice"><input type="radio" name={ENTRY.attend} value={VALUE.attend.no} data-attend="no" /><span>{r.attend.no}</span></label>
        </div>
      </fieldset>

      <div class="field">
        <label for="rsvp-names" data-names-label>{r.names.label}</label>
        <textarea id="rsvp-names" name={ENTRY.names} rows="3" required placeholder={r.names.placeholder} autocomplete="name"></textarea>
      </div>

      <div class="reply__more" data-more>
        <div class="reply__more-inner">
          <fieldset class="field">
            <legend>{r.stay.label}</legend>
            <p class="field__hint">{r.stay.hint}</p>
            <div class="choices">
              <label class="choice"><input type="radio" name={ENTRY.stay} value={VALUE.stay.one} data-yes-required /><span>{r.stay.one}</span></label>
              <label class="choice"><input type="radio" name={ENTRY.stay} value={VALUE.stay.two} /><span>{r.stay.two}</span></label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend>{r.food.label}</legend>
            <p class="field__hint">{r.food.hint}</p>
            <div class="choices">
              <label class="choice"><input type="radio" name={ENTRY.food} value={VALUE.food.none} /><span>{r.food.none}</span></label>
              <label class="choice"><input type="radio" name={ENTRY.food} value={VALUE.food.veggie} /><span>{r.food.veggie}</span></label>
              <label class="choice"><input type="radio" name={ENTRY.food} value={VALUE.food.other} data-other /><span>{r.food.other}</span></label>
            </div>
            <input class="field__other" type="text" name={`${ENTRY.food}.other_option_response`} placeholder={r.food.otherPlaceholder} aria-label={r.food.other} data-other-text />
          </fieldset>

          <fieldset class="field">
            <legend>{r.transfer.label}</legend>
            <p class="field__hint">{r.transfer.hint}</p>
            <div class="choices">
              <label class="choice"><input type="radio" name={ENTRY.transfer} value={VALUE.transfer.yes} /><span>{r.transfer.yes}</span></label>
              <label class="choice"><input type="radio" name={ENTRY.transfer} value={VALUE.transfer.no} /><span>{r.transfer.no}</span></label>
            </div>
          </fieldset>
        </div>
      </div>

      <button class="btn btn--bar reply__submit" type="submit">{r.submit}</button>
      <p class="reply__error" role="alert" hidden>
        {r.error} <a href={FORM_VIEW} target="_blank" rel="noopener" data-fallback>{r.errorLink}</a>.
      </p>
    </form>

    <div class="reply__done" data-done hidden tabindex="-1">
      <div class="reply__done-yes">
        <p class="script-h reply__h">{r.thanksYes.title}</p>
        <p>{r.thanksYes.text}</p>
      </div>
      <div class="reply__done-no">
        <p class="script-h reply__h">{r.thanksNo.title}</p>
        <p>{r.thanksNo.text}</p>
      </div>
      <button class="btn btn--ghost" type="button" data-again>{r.again}</button>
    </div>
  </div>
</section>
