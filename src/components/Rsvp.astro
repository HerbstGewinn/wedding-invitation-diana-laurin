---
import type { Dict } from '../i18n/de';
import { FORM_VIEW } from '../data/rsvp';

interface Props { t: Dict }
const { t } = Astro.props;
const r = t.rsvp;
const people = [
  { name: 'Laurin Herbst', tel: '+49 176 99252846', mail: 'herbst.laurin@gmail.com', mark: 'grapes' as const },
  { name: 'Diana Vinogradova', tel: '+372 555 17718', mail: 'diana.vinogradova11@gmail.com', mark: 'grapes' as const },
];
---

<section class="rsvp" id="antworten" aria-labelledby="rsvp-h">
  <div class="rsvp__side">
    <p class="script-h rsvp__line" data-reveal>{r.line}</p>
    <h3 class="rsvp__contact-h" data-reveal style="--d: 80ms">{r.contactHeading}</h3>
    <ul class="contacts">
      {people.map((p, i) => (
        <li class="contact" data-reveal style={`--d: ${140 + i * 80}ms`}>
          <img class="contact__mark" src={`${import.meta.env.BASE_URL}img/art/grapes.png`} width="63" height="49" alt="" loading="lazy" />
          <span class="contact__name">{p.name}</span>
          <a href={`tel:${p.tel.replace(/\s/g, '')}`}>{p.tel}</a>
          <a href={`mailto:${p.mail}`}>{p.mail}</a>
        </li>
      ))}
    </ul>
    <figure class="rsvp__kids shutter" data-reveal>
      <img src={`${import.meta.env.BASE_URL}img/us/curly-kids.webp`} width="1122" height="1402" alt={t.footer.kidsAlt} loading="lazy" decoding="async" />
    </figure>
  </div>

  <div class="reply" data-reveal style="--d: 120ms">
    <h2 class="script-h reply__h" id="rsvp-h">{r.heading}</h2>
    <p class="reply__note">{r.note}</p>
    <a class="btn btn--bar reply__submit" href={FORM_VIEW} target="_blank" rel="noopener">{r.cta}</a>
  </div>
</section>
